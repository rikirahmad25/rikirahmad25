APP_ENV=dev
APP_DEBUG=true
BOT_TOKEN=123456:telegram-bot-token
BOT_USERNAME=your_bot_username
OWNER_TELEGRAM_ID=123456789
DATABASE_URL=postgresql+asyncpg://botuser:botpass@127.0.0.1:5432/telegram_sales_bot
REDIS_URL=redis://127.0.0.1:6379/0
API_BASE_URL=https://example.com
API_HOST=0.0.0.0
API_PORT=8000
WEBHOOK_SECRET=change-me
DEFAULT_CURRENCY=IRT
ORDER_AUTO_CANCEL_MINUTES=30
ORDER_ADMIN_ALERT_MINUTES=20
# عضویت اجباری، شماره تلفن اجباری و آیدی پشتیبانی از داخل تنظیمات ربات مدیریت می‌شوند.
FORCE_JOIN_CHANNELS=
REQUIRE_PHONE=false
ONLY_IR_PHONE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# زرین‌پال از داخل تنظیمات ربات هم قابل ثبت است؛ این‌ها fallback هستند.
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=https://example.com/payments/zarinpal/callback
# Plisio از داخل تنظیمات ربات ثبت می‌شود. Callback پیشنهادی:
# https://example.com/payments/plisio/callback?json=true
# اطلاعات کارت‌به‌کارت از داخل تنظیمات ربات قابل ویرایش است؛ این‌ها fallback هستند.
CARD_TO_CARD_NUMBER=6037-xxxx-xxxx-xxxx
CARD_TO_CARD_HOLDER=Your Name
CARD_TO_CARD_BANK=Bank Name
